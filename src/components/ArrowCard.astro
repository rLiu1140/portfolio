---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"projects">;
};

const { entry } = Astro.props;
---

<a 
  href={`/portfolio/${entry.collection}/${entry.slug}`}
  class="relative flex justify-between p-4 rounded-lg border border-black/15 dark:border-white/20 bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 transition-colors duration-300 ease-in-out group"
>
  <div class="flex flex-col flex-grow">
    <div class="font-semibold text-black dark:text-white">
      {entry.data.title}
    </div>
    <div class="text-sm text-black/60 dark:text-white/60 line-clamp-2 mt-1">
      {entry.data.description}
    </div>
  </div>
  <div class="flex items-center justify-center ml-4">
    <svg 
      xmlns="http://www.w3.org/2000/svg" 
      viewBox="0 0 24 24" 
      class="w-5 h-5 stroke-current text-black/50 dark:text-white/50 group-hover:text-black dark:group-hover:text-white group-hover:translate-x-1 transition-all duration-300 ease-in-out"
      fill="none" 
      stroke-width="2" 
      stroke-linecap="round" 
      stroke-linejoin="round"
    >
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </div>
</a>