---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"projects">;
};

const { entry } = Astro.props;
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class="group flex flex-col h-full overflow-hidden rounded-lg border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 transition-colors duration-300 ease-in-out hover:bg-black/10 dark:hover:bg-white/10"
>
  <div class="relative h-48 w-full overflow-hidden">
    {
      entry.data.heroImage ? (
        <Image
          src={entry.data.heroImage}
          alt={entry.data.title}
          class="h-full w-full object-cover transition-transform duration-300 ease-in-out group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-black/5 dark:bg-white/5">
          <span class="text-sm text-black/50 dark:text-white/50">No Image</span>
        </div>
      )
    }
  </div>

  <div class="flex flex-col flex-1 p-4">
    <h3 class="font-semibold text-black dark:text-white mb-2">
      {entry.data.title}
    </h3>
    <p class="text-sm text-black/75 dark:text-white/75 line-clamp-3">
      {entry.data.description}
    </p>
  </div>
</a>
