---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
import BackToTop from "@components/BackToTop.astro";
---

<footer class="animate">
  <Container>
    <div class="relative">
      <div class="absolute right-0 -top-20">
        <BackToTop />
      </div>
    </div>
    <div class="flex justify-between items-center">
      <div class="text-black/50 dark:text-white/50">
        2026 {`|`} {SITE.NAME}
      </div>
      <div class="flex flex-wrap gap-1 items-center">
        
        {/* Light Theme Button */}
        <button
          id="light-theme-button"
          aria-label="Light theme"
          class="group icon-toggle-btn text-black/50 dark:text-white/50 hover:text-black hover:dark:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>

        {/* Dark Theme Button */}
        <button
          id="dark-theme-button"
          aria-label="Dark theme"
          class="group icon-toggle-btn text-black/50 dark:text-white/50 hover:text-black hover:dark:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        {/* System Theme Button */}
        <button
          id="system-theme-button"
          aria-label="System theme"
          class="group icon-toggle-btn text-black/50 dark:text-white/50 hover:text-black hover:dark:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </button>
      </div>
    </div>
  </Container>
</footer>

<script>
  import { setToggleState } from "@lib/utils";

  function updateThemeButtons() {
    const theme = localStorage.getItem("theme");
    const lightBtn = document.getElementById("light-theme-button");
    const darkBtn = document.getElementById("dark-theme-button");
    const systemBtn = document.getElementById("system-theme-button");

    setToggleState(lightBtn, theme === "light");
    setToggleState(darkBtn, theme === "dark");
    setToggleState(systemBtn, theme !== "light" && theme !== "dark");
  }

  document.addEventListener("DOMContentLoaded", updateThemeButtons);
  document.addEventListener("astro:page-load", updateThemeButtons);
  
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest("button");
    if (btn && ["light-theme-button", "dark-theme-button", "system-theme-button"].includes(btn.id)) {
      setTimeout(updateThemeButtons, 10);
    }
  });
</script>