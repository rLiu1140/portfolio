---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";

// Featured projects: non-draft entries with an `order` of 1-4, in that order.
const projects = (await getCollection("projects"))
  .filter(
    (project) =>
      !project.data.draft &&
      project.data.order !== undefined &&
      project.data.order >= 1 &&
      project.data.order <= 4,
  )
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      {SITE.NAME}
    </h4>
    <h4 class="animate font-semibold text-black dark:text-white">
      Mechanical Engineering · Northwestern University
    </h4>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            I love to design, build, and optimize electromechanical systems. I'm dedicated to creating thoughtful hardware solutions to real-world problems.
          </p>
          <p class="animate">
            I'm drawn to elegant and efficient systems that actually work. Currently exploring robotics, product design, and advanced manufacturing.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Featured Projects
          </h5>
          <Link href="/portfolio/projects" class="link-fade">
            See all projects
          </Link>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {projects.map((project) => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map((social) => (
            <li class="flex gap-x-2 text-nowrap">
              <Link
                href={social.HREF}
                external
                aria-label={`${SITE.NAME} on ${social.NAME}`}
                class="link-fade"
              >
                {social.NAME}
              </Link>
              <span class="text-black/30 dark:text-white/30">/</span>
            </li>
          ))}
          <li class="line-clamp-1">
            <Link
              href={`mailto:${SITE.EMAIL}`}
              aria-label={`Email ${SITE.NAME}`}
              class="link-fade"
            >
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
